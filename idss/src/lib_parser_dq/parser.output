Terminals unused in grammar

    EOL
    UNKNOWN


Grammar

    0 $accept: entire_clause $end

    1 entire_clause: SELECT SPACE fieldlist SPACE FROM SPACE tablelist whereclause

    2 fieldlist: fieldlistnoagg
    3          | fieldlistagg

    4 fieldlistnoagg: fieldname
    5               | fieldlistnoagg COMMA fieldname

    6 fieldlistagg: aggname
    7             | fieldlistagg COMMA aggname

    8 tablelist: tablename
    9          | tablelist COMMA tablename
   10          | tablelist JOIN tablename
   11          | tablelist JOIN tablename ON dottedfieldname completeoperator dottedfieldname

   12 tablename: NAME
   13          | NAME ALIAS NAME

   14 fieldname: dottedfieldname
   15          | dottedfieldname ALIAS NAME

   16 aggname: AGGF
   17        | AGGF ALIAS NAME

   18 dottedfieldname: NAME
   19                | NAME DOT NAME
   20                | ASTERISK
   21                | NAME DOT ASTERISK

   22 whereclause: ε
   23            | SEMICOLON
   24            | SPACE WHERE SPACE conditions
   25            | SPACE WHERE SPACE conditions SEMICOLON

   26 conditions: conditions SPACE OR SPACE OP conditions CP
   27           | conditions SPACE AND SPACE OP conditions CP
   28           | OP conditions CP
   29           | condition

   30 condition: dottedfieldname completeoperator NUMBER
   31          | dottedfieldname simpleoperator STRING
   32          | dottedfieldname simpleoperator BOOL
   33          | dottedfieldname completeoperator innerqueryagg
   34          | dottedfieldname inclusionoperator innerquerynoagg

   35 completeoperator: EQ
   36                 | GT
   37                 | LT
   38                 | GTE
   39                 | LTE
   40                 | NE

   41 simpleoperator: EQ
   42               | NE

   43 inclusionoperator: IN
   44                  | NOT IN

   45 innerquerynoagg: OP SELECT SPACE fieldname SPACE FROM SPACE tablelist innerquerywhereclause CP

   46 innerqueryagg: OP SELECT SPACE aggname SPACE FROM SPACE tablelist innerquerywhereclause CP

   47 innerquerywhereclause: ε
   48                      | SPACE WHERE SPACE innerqueryconditions

   49 innerqueryconditions: innerqueryconditions SPACE OR SPACE OP innerqueryconditions CP
   50                     | innerqueryconditions SPACE AND SPACE OP innerqueryconditions CP
   51                     | OP innerqueryconditions CP
   52                     | innerquerycondition

   53 innerquerycondition: dottedfieldname completeoperator NUMBER
   54                    | dottedfieldname simpleoperator STRING
   55                    | dottedfieldname simpleoperator BOOL


