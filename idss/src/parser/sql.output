Grammar

    0 $accept: stmtmulti $end

    1 stmtmulti: stmt
    2          | stmtmulti stmt

    3 stmt: SelectStmt ';'

    4 SelectStmt: select_no_parens
    5           | select_with_parens

    6 select_with_parens: '(' select_no_parens ')'
    7                   | '(' select_with_parens ')'

    8 select_no_parens: simple_select
    9                 | select_clause sort_clause
   10                 | select_clause opt_sort_clause for_update_clause opt_select_limit
   11                 | select_clause opt_sort_clause select_limit opt_for_update_clause

   12 select_clause: simple_select
   13              | select_with_parens

   14 simple_select: SELECT opt_distinct target_list into_clause from_clause where_clause group_clause having_clause
   15              | select_clause UNION opt_all select_clause
   16              | select_clause INTERSECT opt_all select_clause
   17              | select_clause EXCEPT opt_all select_clause

   18 into_clause: INTO OptTempTableName
   19            | ε

   20 OptTempTableName: TEMPORARY opt_table qualified_name
   21                 | TEMP opt_table qualified_name
   22                 | LOCAL TEMPORARY opt_table qualified_name
   23                 | LOCAL TEMP opt_table qualified_name
   24                 | GLOBAL TEMPORARY opt_table qualified_name
   25                 | GLOBAL TEMP opt_table qualified_name
   26                 | TABLE qualified_name
   27                 | qualified_name

   28 qualified_name: relation_name
   29               | dotted_name

   30 opt_table: TABLE
   31          | ε

   32 opt_all: ALL
   33        | DISTINCT
   34        | ε

   35 opt_distinct: DISTINCT
   36             | DISTINCT ON '(' expr_list ')'
   37             | ALL
   38             | ε

   39 opt_sort_clause: sort_clause
   40                | ε

   41 sort_clause: ORDER BY sortby_list

   42 sortby_list: sortby
   43            | sortby_list ',' sortby

   44 sortby: a_expr USING qual_all_Op
   45       | a_expr ASC
   46       | a_expr DESC
   47       | a_expr

   48 select_limit: LIMIT select_limit_value OFFSET select_offset_value
   49             | OFFSET select_offset_value LIMIT select_limit_value
   50             | LIMIT select_limit_value
   51             | OFFSET select_offset_value
   52             | LIMIT select_limit_value ',' select_offset_value

   53 opt_select_limit: select_limit
   54                 | ε

   55 select_limit_value: a_expr
   56                   | ALL

   57 select_offset_value: a_expr

   58 group_clause: GROUP_P BY expr_list
   59             | ε

   60 having_clause: HAVING a_expr
   61              | ε

   62 for_update_clause: FOR UPDATE update_list
   63                  | FOR READ ONLY

   64 opt_for_update_clause: for_update_clause
   65                      | ε

   66 update_list: OF name_list
   67            | ε

   68 from_clause: FROM from_list
   69            | ε

   70 from_list: table_ref
   71          | from_list ',' table_ref

   72 table_ref: relation_expr
   73          | relation_expr alias_clause
   74          | func_table
   75          | func_table alias_clause
   76          | func_table AS '(' TableFuncElementList ')'
   77          | func_table AS ColId '(' TableFuncElementList ')'
   78          | func_table ColId '(' TableFuncElementList ')'
   79          | select_with_parens
   80          | select_with_parens alias_clause
   81          | joined_table
   82          | '(' joined_table ')' alias_clause

   83 joined_table: '(' joined_table ')'
   84             | table_ref CROSS JOIN table_ref
   85             | table_ref UNIONJOIN table_ref
   86             | table_ref join_type JOIN table_ref join_qual
   87             | table_ref JOIN table_ref join_qual
   88             | table_ref NATURAL join_type JOIN table_ref
   89             | table_ref NATURAL JOIN table_ref

   90 alias_clause: AS ColId '(' name_list ')'
   91             | AS ColId
   92             | ColId '(' name_list ')'
   93             | ColId

   94 join_type: FULL join_outer
   95          | LEFT join_outer
   96          | RIGHT join_outer
   97          | INNER_P

   98 join_outer: OUTER_P
   99           | ε

  100 join_qual: USING '(' name_list ')'
  101          | ON a_expr

  102 relation_expr: qualified_name
  103              | qualified_name '*'
  104              | ONLY qualified_name
  105              | ONLY '(' qualified_name ')'

  106 func_table: func_name '(' ')'
  107           | func_name '(' expr_list ')'

  108 where_clause: WHERE a_expr
  109             | ε

  110 TableFuncElementList: TableFuncElement
  111                     | TableFuncElementList ',' TableFuncElement

  112 TableFuncElement: ColId Typename

  113 Typename: SimpleTypename opt_array_bounds
  114         | SETOF SimpleTypename opt_array_bounds
  115         | SimpleTypename ARRAY '[' Iconst ']'
  116         | SETOF SimpleTypename ARRAY '[' Iconst ']'

  117 opt_array_bounds: opt_array_bounds '[' ']'
  118                 | opt_array_bounds '[' Iconst ']'
  119                 | ε

  120 SimpleTypename: GenericType
  121               | Numeric
  122               | Bit
  123               | Character
  124               | ConstDatetime
  125               | ConstInterval opt_interval
  126               | ConstInterval '(' Iconst ')' opt_interval
  127               | type_name attrs

  128 ConstTypename: GenericType
  129              | Numeric
  130              | ConstBit
  131              | ConstCharacter
  132              | ConstDatetime

  133 GenericType: type_name

  134 Numeric: INT_P
  135        | INTEGER
  136        | SMALLINT
  137        | BIGINT
  138        | REAL
  139        | FLOAT_P opt_float
  140        | DOUBLE_P PRECISION
  141        | DECIMAL_P opt_decimal
  142        | DEC opt_decimal
  143        | NUMERIC opt_numeric
  144        | BOOLEAN_P

  145 opt_float: '(' Iconst ')'
  146          | ε

  147 opt_numeric: '(' Iconst ',' Iconst ')'
  148            | '(' Iconst ')'
  149            | ε

  150 opt_decimal: '(' Iconst ',' Iconst ')'
  151            | '(' Iconst ')'
  152            | ε

  153 Bit: BitWithLength
  154    | BitWithoutLength

  155 ConstBit: BitWithLength
  156         | BitWithoutLength

  157 BitWithLength: BIT opt_varying '(' Iconst ')'

  158 BitWithoutLength: BIT opt_varying

  159 Character: CharacterWithLength
  160          | CharacterWithoutLength

  161 ConstCharacter: CharacterWithLength
  162               | CharacterWithoutLength

  163 CharacterWithLength: character '(' Iconst ')' opt_charset

  164 CharacterWithoutLength: character opt_charset

  165 character: CHARACTER opt_varying
  166          | CHAR_P opt_varying
  167          | VARCHAR
  168          | NATIONAL CHARACTER opt_varying
  169          | NATIONAL CHAR_P opt_varying
  170          | NCHAR opt_varying

  171 opt_varying: VARYING
  172            | ε

  173 opt_charset: CHARACTER SET ColId
  174            | ε

  175 ConstDatetime: TIMESTAMP '(' Iconst ')' opt_timezone
  176              | TIMESTAMP opt_timezone
  177              | TIME '(' Iconst ')' opt_timezone
  178              | TIME opt_timezone

  179 ConstInterval: INTERVAL

  180 opt_timezone: WITH TIME ZONE
  181             | WITHOUT TIME ZONE
  182             | ε

  183 opt_interval: YEAR_P
  184             | MONTH_P
  185             | DAY_P
  186             | HOUR_P
  187             | MINUTE_P
  188             | SECOND_P
  189             | YEAR_P TO MONTH_P
  190             | DAY_P TO HOUR_P
  191             | DAY_P TO MINUTE_P
  192             | DAY_P TO SECOND_P
  193             | HOUR_P TO MINUTE_P
  194             | HOUR_P TO SECOND_P
  195             | MINUTE_P TO SECOND_P
  196             | ε

  197 r_expr: row IN_P select_with_parens
  198       | row NOT IN_P select_with_parens
  199       | row qual_all_Op sub_type select_with_parens
  200       | row qual_all_Op select_with_parens
  201       | row qual_all_Op row
  202       | row IS NULL_P
  203       | row IS NOT NULL_P
  204       | row OVERLAPS row
  205       | row IS DISTINCT FROM row

  206 row: ROW '(' row_descriptor ')'
  207    | ROW '(' a_expr ')'
  208    | ROW '(' ')'
  209    | '(' row_descriptor ')'

  210 row_descriptor: expr_list ',' a_expr

  211 sub_type: ANY
  212         | SOME
  213         | ALL

  214 all_Op: Op
  215       | MathOp

  216 MathOp: '+'
  217       | '-'
  218       | '*'
  219       | '/'
  220       | '%'
  221       | '^'
  222       | '<'
  223       | '>'
  224       | '='

  225 qual_Op: Op
  226        | OPERATOR '(' any_operator ')'

  227 any_operator: all_Op
  228             | ColId '.' any_operator

  229 qual_all_Op: all_Op
  230            | OPERATOR '(' any_operator ')'

  231 a_expr: c_expr
  232       | a_expr TYPECAST Typename
  233       | a_expr AT TIME ZONE c_expr
  234       | '+' a_expr
  235       | '-' a_expr
  236       | '%' a_expr
  237       | '^' a_expr
  238       | a_expr '%'
  239       | a_expr '^'
  240       | a_expr '+' a_expr
  241       | a_expr '-' a_expr
  242       | a_expr '*' a_expr
  243       | a_expr '/' a_expr
  244       | a_expr '%' a_expr
  245       | a_expr '^' a_expr
  246       | a_expr '<' a_expr
  247       | a_expr '>' a_expr
  248       | a_expr '=' a_expr
  249       | a_expr qual_Op a_expr
  250       | qual_Op a_expr
  251       | a_expr qual_Op
  252       | a_expr AND a_expr
  253       | a_expr OR a_expr
  254       | NOT a_expr
  255       | a_expr LIKE a_expr
  256       | a_expr LIKE a_expr ESCAPE a_expr
  257       | a_expr NOT LIKE a_expr
  258       | a_expr NOT LIKE a_expr ESCAPE a_expr
  259       | a_expr ILIKE a_expr
  260       | a_expr ILIKE a_expr ESCAPE a_expr
  261       | a_expr NOT ILIKE a_expr
  262       | a_expr NOT ILIKE a_expr ESCAPE a_expr
  263       | a_expr SIMILAR TO a_expr
  264       | a_expr SIMILAR TO a_expr ESCAPE a_expr
  265       | a_expr NOT SIMILAR TO a_expr
  266       | a_expr NOT SIMILAR TO a_expr ESCAPE a_expr
  267       | a_expr ISNULL
  268       | a_expr IS NULL_P
  269       | a_expr NOTNULL
  270       | a_expr IS NOT NULL_P
  271       | a_expr IS TRUE_P
  272       | a_expr IS NOT TRUE_P
  273       | a_expr IS FALSE_P
  274       | a_expr IS NOT FALSE_P
  275       | a_expr IS UNKNOWN
  276       | a_expr IS NOT UNKNOWN
  277       | a_expr IS DISTINCT FROM a_expr
  278       | a_expr IS OF '(' type_list ')'
  279       | a_expr IS NOT OF '(' type_list ')'
  280       | a_expr BETWEEN b_expr AND b_expr
  281       | a_expr NOT BETWEEN b_expr AND b_expr
  282       | a_expr IN_P in_expr
  283       | a_expr NOT IN_P in_expr
  284       | a_expr qual_all_Op sub_type select_with_parens
  285       | a_expr qual_all_Op sub_type '(' a_expr ')'
  286       | UNIQUE select_with_parens
  287       | r_expr

  288 b_expr: c_expr
  289       | b_expr TYPECAST Typename
  290       | '+' b_expr
  291       | '-' b_expr
  292       | '%' b_expr
  293       | '^' b_expr
  294       | b_expr '%'
  295       | b_expr '^'
  296       | b_expr '+' b_expr
  297       | b_expr '-' b_expr
  298       | b_expr '*' b_expr
  299       | b_expr '/' b_expr
  300       | b_expr '%' b_expr
  301       | b_expr '^' b_expr
  302       | b_expr '<' b_expr
  303       | b_expr '>' b_expr
  304       | b_expr '=' b_expr
  305       | b_expr qual_Op b_expr
  306       | qual_Op b_expr
  307       | b_expr qual_Op
  308       | b_expr IS DISTINCT FROM b_expr
  309       | b_expr IS OF '(' type_list ')'
  310       | b_expr IS NOT OF '(' type_list ')'

  311 c_expr: columnref
  312       | AexprConst
  313       | PARAM attrs opt_indirection
  314       | '(' a_expr ')' attrs opt_indirection
  315       | '(' a_expr ')' opt_indirection
  316       | case_expr
  317       | func_name '(' ')'
  318       | func_name '(' expr_list ')'
  319       | func_name '(' ALL expr_list ')'
  320       | func_name '(' DISTINCT expr_list ')'
  321       | func_name '(' '*' ')'
  322       | CURRENT_DATE
  323       | CURRENT_TIME
  324       | CURRENT_TIME '(' Iconst ')'
  325       | CURRENT_TIMESTAMP
  326       | CURRENT_TIMESTAMP '(' Iconst ')'
  327       | LOCALTIME
  328       | LOCALTIME '(' Iconst ')'
  329       | LOCALTIMESTAMP
  330       | LOCALTIMESTAMP '(' Iconst ')'
  331       | CURRENT_USER
  332       | SESSION_USER
  333       | USER
  334       | CAST '(' a_expr AS Typename ')'
  335       | EXTRACT '(' extract_list ')'
  336       | OVERLAY '(' overlay_list ')'
  337       | POSITION '(' position_list ')'
  338       | SUBSTRING '(' substr_list ')'
  339       | TREAT '(' a_expr AS Typename ')'
  340       | TRIM '(' BOTH trim_list ')'
  341       | TRIM '(' LEADING trim_list ')'
  342       | TRIM '(' TRAILING trim_list ')'
  343       | TRIM '(' trim_list ')'
  344       | CONVERT '(' a_expr USING any_name ')'
  345       | CONVERT '(' expr_list ')'
  346       | select_with_parens
  347       | EXISTS select_with_parens
  348       | ARRAY select_with_parens
  349       | ARRAY array_expr

  350 any_name: ColId
  351         | dotted_name

  352 opt_indirection: opt_indirection '[' a_expr ']'
  353                | opt_indirection '[' a_expr ':' a_expr ']'
  354                | ε

  355 expr_list: a_expr
  356          | expr_list ',' a_expr

  357 extract_list: extract_arg FROM a_expr
  358             | ε

  359 type_list: type_list ',' Typename
  360          | Typename

  361 array_expr_list: array_expr
  362                | array_expr_list ',' array_expr

  363 array_expr: '[' expr_list ']'
  364           | '[' array_expr_list ']'

  365 extract_arg: IDENT
  366            | YEAR_P
  367            | MONTH_P
  368            | DAY_P
  369            | HOUR_P
  370            | MINUTE_P
  371            | SECOND_P
  372            | SCONST

  373 overlay_list: a_expr overlay_placing substr_from substr_for
  374             | a_expr overlay_placing substr_from

  375 overlay_placing: PLACING a_expr

  376 position_list: b_expr IN_P b_expr
  377              | ε

  378 substr_list: a_expr substr_from substr_for
  379            | a_expr substr_for substr_from
  380            | a_expr substr_from
  381            | a_expr substr_for
  382            | expr_list
  383            | ε

  384 substr_from: FROM a_expr

  385 substr_for: FOR a_expr

  386 trim_list: a_expr FROM expr_list
  387          | FROM expr_list
  388          | expr_list

  389 in_expr: select_with_parens
  390        | '(' expr_list ')'

  391 case_expr: CASE case_arg when_clause_list case_default END_P
  392          | NULLIF '(' a_expr ',' a_expr ')'
  393          | COALESCE '(' expr_list ')'

  394 when_clause_list: when_clause
  395                 | when_clause_list when_clause

  396 when_clause: WHEN a_expr THEN a_expr

  397 case_default: ELSE a_expr
  398             | ε

  399 case_arg: a_expr
  400         | ε

  401 columnref: relation_name opt_indirection
  402          | dotted_name opt_indirection

  403 dotted_name: relation_name attrs

  404 attrs: '.' attr_name
  405      | '.' '*'
  406      | '.' attr_name attrs

  407 target_list: target_el
  408            | target_list ',' target_el

  409 target_el: a_expr AS ColLabel
  410          | a_expr
  411          | '*'

  412 relation_name: SpecialRuleRelation
  413              | ColId

  414 name_list: name
  415          | name_list ',' name

  416 name: ColId

  417 attr_name: ColId

  418 func_name: function_name
  419          | dotted_name

  420 AexprConst: Iconst
  421           | FCONST
  422           | Sconst
  423           | BCONST
  424           | XCONST
  425           | ConstTypename Sconst
  426           | ConstInterval Sconst opt_interval
  427           | ConstInterval '(' Iconst ')' Sconst opt_interval
  428           | PARAM opt_indirection
  429           | TRUE_P
  430           | FALSE_P
  431           | NULL_P

  432 Iconst: ICONST

  433 Sconst: SCONST

  434 ColId: IDENT
  435      | unreserved_keyword
  436      | col_name_keyword

  437 type_name: IDENT
  438          | unreserved_keyword

  439 function_name: IDENT
  440              | unreserved_keyword
  441              | func_name_keyword

  442 ColLabel: IDENT
  443         | unreserved_keyword
  444         | col_name_keyword
  445         | func_name_keyword
  446         | reserved_keyword

